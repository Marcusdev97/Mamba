# Evolution API
AUTHENTICATION_API_KEY=replace-with-a-long-random-key
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:replace-with-database-password@postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Redis
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Mamba integrations
NOTION_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watchdog timing is managed from Settings. Blank values use 30s / 1min / no repeat.
MAMBA_WATCHDOG_TELEGRAM_ENABLED=
MAMBA_WATCHDOG_INTERVAL_SECONDS=
MAMBA_WATCHDOG_TELEGRAM_DELAY_MINUTES=
MAMBA_WATCHDOG_TELEGRAM_REMINDER_MINUTES=

# Safe TEST recipients only. Leave empty here; Settings writes this value for you.
# Format: Name:phone:language,Name:phone:language
TEST_LEADS=

# Sales Brain is disabled by default.
MAMBA_BRAIN_ENABLED=0
BRAIN_AI_PROVIDER=rules
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Cloudflare R2 assets
CF_ACCOUNT_ID=
CF_R2_BUCKET=mamba-assets
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_URL=
CF_R2_PREFIX=mamba-assets
